FRONTEND_DIR=../gungnir v2
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://gungnir:gungnir@postgres:5432/gungnir
REDIS_URL=redis://redis:6379
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
BACKEND_API_URL=http://backend:4000/api
CORS_ORIGIN=https://app.example.com
FRONTEND_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_WS_URL=https://api.example.com/realtime
NEXT_PUBLIC_SITE_URL=https://app.example.com
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
